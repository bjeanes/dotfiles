@@ -738,6 +738,37 @@ herdr_cleanup_unlaunched() {
     print_output_and_exit "${rc:-1}"
 fi
 
+# rex: split pane via rex CLI with sentinel file for blocking
+if [ "${TERM_PROGRAM:-}" = "rex" ] && [ -n "${REX_SESSION:-}" ] && [ -n "${REX_BLOCK:-}" ] &&
+    command -v rex >/dev/null 2>&1; then
+    SENTINEL=$(mktemp "$TMPBASE/revdiff-done-XXXXXX")
+    rm -f "$SENTINEL"
+
+    REX_PCT="${REVDIFF_POPUP_HEIGHT:-90%}"
+    REX_PCT="${REX_PCT%%%}"
+    trap 'rm -f "$OUTPUT_FILE" "$ERR_FILE" "$STDIN_FILE" "$SENTINEL" "$SENTINEL.tmp"' EXIT
+    if ! REX_NEW=$(rex split -s "$REX_SESSION" -b "$REX_BLOCK" --split=below --ratio "$REX_PCT" \
+        -c "$CWD" --label "$OVERLAY_TITLE" --json -- sh -c "$(write_rc_cmd "$SENTINEL")" 2>&1); then
+        echo "error: rex split failed: $REX_NEW" >&2
+        exit 1
+    fi
+    REX_PANE=""
+    if command -v jq >/dev/null 2>&1; then
+        REX_PANE=$(printf '%s' "$REX_NEW" | jq -r '.block_ids[0] // empty' 2>/dev/null || true)
+    fi
+
+    while [ ! -f "$SENTINEL" ]; do
+        sleep 0.3
+    done
+    rc=$(read_rc "$SENTINEL")
+    # close the pane ourselves; rex keeps it open when its program fails quickly
+    if [ -n "$REX_PANE" ]; then
+        rex block close -s "$REX_SESSION" "$REX_PANE" >/dev/null 2>&1 || true
+    fi
+    rm -f "$SENTINEL"
+    print_output_and_exit "${rc:-1}"
+fi
+
 # ghostty: split pane via AppleScript (macOS only, requires Ghostty 1.3.0+)
 if [ "${TERM_PROGRAM:-}" = "ghostty" ] && command -v osascript >/dev/null 2>&1; then
 
